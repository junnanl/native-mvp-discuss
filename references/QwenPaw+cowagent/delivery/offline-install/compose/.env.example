# Host-facing configuration only.
COW_IMAGE=cowagent-offline:2.1.7-base.1-dev
COW_COMPOSE_PROJECT_NAME=cowagent-offline
COW_CONTAINER_NAME=cowagent-offline
COW_WEB_PORT=9899
COW_WEB_PASSWORD=
COW_LANG=zh
COW_CHANNEL_TYPE=web

# Model initialization values. Fill these on the customer server; do not package real keys.
# After storage/cow/app-config/config.json is initialized and mounted, the Web console
# and that file are the source of truth. Startup must not overwrite them on every restart.
# For a model service on the Docker host, use host.docker.internal instead of 127.0.0.1.
MODEL=deepseek-v4-pro
BOT_TYPE=dashscope
OPEN_AI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPEN_AI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=

# Agent runtime limits.
COW_AGENT_MAX_CONTEXT_TOKENS=50000
COW_AGENT_MAX_CONTEXT_TURNS=20
COW_AGENT_MAX_STEPS=20
COW_REQUIRED_SKILL_DIRS=xlsx,docx,official-writing,markdown-converter,Word---DOCX,pdf,pptx,eda-reporter,browser-use

# Optional embedding / rerank settings.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=
RERANK_PROVIDER=dashscope
